# ===== 环境变量模板：复制为 .env 并填入真实值 =====
# DeepSeek API（多智能体 LLM 推理必需）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Ollama 本地嵌入模型（机制② 语义匹配 Embed(·)，可选）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=BGE-M3:latest

# 可选：LLM 嵌入 API（若配置则优先于 Ollama）
# EMBED_API_BASE=https://api.openai.com/v1
# EMBED_API_KEY=sk-xxx
# EMBED_API_MODEL=text-embedding-3-small

# 参数标定（可选，默认值见各模块）
# TAG_MATCH_THRESHOLD=0.62     # 语义标签匹配阈值 τ
# TOOL_MATCH_THRESHOLD=0.55    # 工具链检索阈值 τ_e
# COMM_TIMEOUT=120             # 通信超时阈值 T_timeout（秒）

# 运行模式（可选）
# FAST_MODE=0                  # 1=跳过 LLM 融合（调试用），0=完整机制（默认）
